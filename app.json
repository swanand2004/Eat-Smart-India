{
  "expo": {
    "name": "EatSmart",
    "slug": "eatsmart",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
     
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourcompany.eatsmart",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow EatSmart to access your photos for food tracking",
        "NSCameraUsageDescription": "Allow EatSmart to use your camera for food photos"
      }
    },
    "android": {
      "adaptiveIcon": {
       
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.yourcompany.eatsmart",
      "permissions": []
    },
    "web": {
   
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "compileSdkVersion": 33,
            "targetSdkVersion": 33,
            "buildToolsVersion": "33.0.0"
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      [
        "expo-font"
      ]
    ],
